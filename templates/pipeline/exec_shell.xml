pipeline {
    agent any
    parameters {
    stashedFile 'stashedFile'
    stashedFile 'private_key'
    string(name: 'shell_name', defaultValue: 'run.sh',description:'shell_name')
    }
    stages {
        stage('上传文件处理') {
            steps {            
                script {                 
                    try {
                        unstash 'stashedFile'
                        unstash 'private_key'

                        

                        sh '''                                             
                         
                           mkdir -p task_${BUILD_ID}/
                           mv  stashedFile task_${BUILD_ID}/${shell_name}
                           chmod +x  task_${BUILD_ID}/${shell_name}
                         
                        '''
                    } catch (Exception e) {
                        echo "Failed to unstash: ${e.getMessage()}"
                        // Add appropriate exception handling here
                    }
                }
                

                sh '''            
                    
                               
                       sudo task_${BUILD_ID}/${shell_name}
                       
                '''
                
            }
        }
        
      
    }
}
